# このファイルを secrets.env にコピーして値を設定する(secrets.env はGit管理外)
# 使い方: set -a; source config/secrets.env; set +a

# AIアドバイザー(Claude API) — https://platform.claude.com で発行
ANTHROPIC_API_KEY=

# --- 以下は実弾移行時(Phase 2)にのみ必要 ---
# Alpaca (米国株)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# paper-api.alpaca.markets(偽金・並走テスト用) または api.alpaca.markets(実弾)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# 成行注文のポーリング上限秒(市場開場中はほぼ即約定。閉場中は未約定→sync-fillsで反映)
SMZ_ORDER_TIMEOUT=90

# ★実弾の最終安全装置★: config を live にしただけでは発注しない。
# 本物のお金で発注を有効化する時だけ、次の一行のコメントを外す(フレーズは完全一致必須):
# SMZ_LIVE_CONFIRM=I understand this trades real money

# auカブコム証券 kabuステーションAPI (日本株・Phase 3)
KABU_STATION_PASSWORD=
